{
    "$schema": "vendor/infection/infection/resources/schema.json",
    // Tests de mutation sur le domaine uniquement (cf. bonnes-pratiques.md : score >= 80 %)
    "source": {
        "directories": ["src/Shared/Domain", "src/Scheduling/Domain"]
    },
    "minMsi": 80,
    "minCoveredMsi": 80,
    "testFrameworkOptions": "--testsuite=unit",
    "logs": {
        "text": "var/infection/infection.log",
        "github": true
    },
    "mutators": {
        "@default": true
    }
}
