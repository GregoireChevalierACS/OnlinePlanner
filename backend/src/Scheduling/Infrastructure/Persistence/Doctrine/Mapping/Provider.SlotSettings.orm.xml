<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="App\Scheduling\Domain\Provider\SlotSettings">
        <field name="durationMinutes" type="smallint" column="slot_duration_minutes"/>
        <field name="bufferMinutes" type="smallint" column="slot_buffer_minutes"/>
        <field name="minimumNoticeMinutes" type="integer" column="minimum_notice_minutes"/>
    </embeddable>
</doctrine-mapping>
