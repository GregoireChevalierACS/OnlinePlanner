<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Scheduling\Domain\Provider\Provider" table="provider">
        <id name="id" type="provider_id" column="id"/>
        <field name="name" type="string" length="255"/>
        <field name="schedule" type="weekly_schedule"/>
        <embedded name="settings" class="App\Scheduling\Domain\Provider\SlotSettings" use-column-prefix="false"/>
    </entity>
</doctrine-mapping>
