<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Champs communs à tous les liens à usage unique (Template Method : OneTimeToken). -->
    <mapped-superclass name="App\Identity\Domain\OneTimeToken">
        <!-- Empreinte SHA-256 du jeton : le jeton en clair n'est jamais stocké. -->
        <id name="tokenHash" type="string" length="64" column="token_hash"/>
        <field name="accountId" type="account_id" column="account_id"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="usedAt" type="datetime_immutable" column="used_at" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
